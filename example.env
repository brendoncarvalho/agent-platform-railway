# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------
# OpenRouter: default chat provider for every agent and default image provider (IMAGE_PROVIDER=openrouter).
OPENROUTER_API_KEY=sk-or-***
# OpenAI: embeddings (knowledge bases) and images when IMAGE_PROVIDER=openai.
OPENAI_API_KEY=sk-***
# Default OpenRouter chat model for the whole platform (app.settings.default_model()).
# OPENROUTER_MODEL=~openai/gpt-mini-latest
# Output token cap for OpenRouter models that do not set their own, including agents created
# from the portal/Studio (agno's own default, 1024, cuts long answers in the middle).
# OPENROUTER_MAX_TOKENS=8192

# ---------------------------------------------------------------------------
# Assistente Pemill — chat model
# The chat model must accept images (vision) for image analysis to work.
#   CHAT_MODEL_PROVIDER: openrouter (default) | openai | google | anthropic
#   CHAT_MODEL_ID: provider model id. Defaults: openrouter -> OPENROUTER_MODEL,
#                  openai -> gpt-5-mini, google -> gemini-2.5-flash, anthropic -> claude-sonnet-4-5
#   google needs `pip install google-genai` + GOOGLE_API_KEY; anthropic needs `pip install anthropic` + ANTHROPIC_API_KEY.
# ---------------------------------------------------------------------------
# CHAT_MODEL_PROVIDER=openrouter
# CHAT_MODEL_ID=
# ASSISTENTE_PEMILL_MEMORY=True            # user memory across sessions (LearningMachine)
# ASSISTENTE_PEMILL_HISTORY_RUNS=10        # previous interactions added to the context
# ASSISTENTE_PEMILL_MAX_TOKENS=4096        # output token cap

# ---------------------------------------------------------------------------
# Assistente Pemill — image generation and image input limits
#   IMAGE_PROVIDER: openrouter (default; generation + edits, any model at
#                   https://openrouter.ai/models?output_modalities=image, uses OPENROUTER_API_KEY)
#                   | openai (generation + edits; gpt-image needs a verified OpenAI org)
#                   | gemini (generation only, needs google-genai)
#   IMAGE_MODEL: defaults: openrouter -> google/gemini-2.5-flash-image, openai -> gpt-image-1,
#                gemini -> imagen-4.0-generate-001
#   IMAGE_API_KEY: optional dedicated key; falls back to OPENROUTER_API_KEY / OPENAI_API_KEY / GOOGLE_API_KEY
# ---------------------------------------------------------------------------
# IMAGE_PROVIDER=openrouter
# IMAGE_MODEL=google/gemini-2.5-flash-image
# IMAGE_SIZE=1024x1024                      # openrouter: WxH -> aspect_ratio, or a tier (1K, 2K, 4K), or 16:9; gpt-image: 1024x1024, 1536x1024, 1024x1536, auto
# IMAGE_QUALITY=auto                        # openrouter/gpt-image: low | medium | high | auto; dall-e-3: standard | hd
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1   # only for proxies/tests
# IMAGE_API_KEY=
# IMAGE_INPUT_MAX_MB=10                     # max size of an image sent by the user
# IMAGE_INPUT_FORMATS=png,jpeg,webp         # accepted input formats

# ---------------------------------------------------------------------------
# Media storage — where uploaded and generated images are persisted.
#   MEDIA_STORAGE: local (default) | s3
#   local: files under MEDIA_STORAGE_DIR (relative to the repo root); compose mounts a volume.
#   s3: any S3-compatible bucket (AWS, MinIO, Cloudflare R2...). Requires `pip install boto3`
#       and credentials in AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY (or an instance role).
# ---------------------------------------------------------------------------
# MEDIA_STORAGE=local
# MEDIA_STORAGE_DIR=storage/media
# MEDIA_S3_BUCKET=
# MEDIA_S3_PREFIX=pemill/media/
# MEDIA_S3_REGION=
# MEDIA_S3_ENDPOINT_URL=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------
# JWT verification for AgentOS. Generate your JWT_VERIFICATION_KEY at os.agno.com.
# In production (RUNTIME_ENV != dev), the app refuses to serve traffic without
# JWT_VERIFICATION_KEY or JWT_JWKS_FILE. Local dev (RUNTIME_ENV=dev) is ok without it.
# Set `authorization=False` in app/main.py to opt out (not recommended).
# ---------------------------------------------------------------------------
# Quote the value so parsers read the multi-line PEM as one variable:
# JWT_VERIFICATION_KEY="-----BEGIN PUBLIC KEY-----
# MIIBIjANBgkq...
# -----END PUBLIC KEY-----"
# JWT_JWKS_FILE=/app/jwks.json

# ---------------------------------------------------------------------------
# AgentOS URL used by the scheduler and MCP server.
# Set this to the public URL of your AgentOS instance.
# ---------------------------------------------------------------------------
# AGENTOS_URL=http://127.0.0.1:8000

# ---------------------------------------------------------------------------
# MCP OAuth — set MCP_CONNECT_SECRET to turn the /mcp endpoint into its own
# OAuth 2.1 authorization server, which is how claude.ai and ChatGPT (web) connect.
# Connecting to the MCP server asks for this secret on a consent page.
# Generate a strong one (≥16 chars):
#   openssl rand -base64 32
# ---------------------------------------------------------------------------
# MCP_CONNECT_SECRET=

# Optional: pin the OAuth token signing key (≥32 chars). Unset, a strong key is
# generated and persisted in the database. Rotating it invalidates outstanding tokens.
# AGENTOS_MCP_SIGNING_KEY=

# ---------------------------------------------------------------------------
# Jira - set these to expose guarded Jira tools (Atendimento Jira agent + Studio registry).
# Basic auth uses Atlassian account email + API token/password. OAuth 2.0
# uses a Jira Cloud 3LO access token and calls api.atlassian.com with cloudId.
# OAuth 1.0 is available for Jira Server/Data Center-style OAuth apps.
#
# By default Jira is read-only (search/get issue). Set JIRA_ENABLE_MUTATIONS=True
# to expose guarded Jira mutations: comment on any issue; edit only comments
# created by this AI tool; move status, set original estimate, and assign owners
# only when explicit in the user's request; and never delete Jira content.
# ---------------------------------------------------------------------------
# JIRA_AUTH_TYPE=basic
# JIRA_SERVER_URL=https://your-domain.atlassian.net
# JIRA_USERNAME=you@example.com
# JIRA_TOKEN=
# JIRA_PASSWORD=
#
# Jira Cloud OAuth 2.0
# Service account OAuth credentials: set client ID + secret and the app will
# request short-lived access tokens with grant_type=client_credentials.
# You may also set JIRA_OAUTH_ACCESS_TOKEN directly for a temporary/manual test.
# JIRA_AUTH_TYPE=oauth2
# JIRA_OAUTH_CLIENT_ID=
# JIRA_OAUTH_CLIENT_SECRET=
# JIRA_OAUTH_ACCESS_TOKEN=
# JIRA_CLOUD_ID=
#
# Jira OAuth 1.0
# JIRA_AUTH_TYPE=oauth1
# JIRA_OAUTH_ACCESS_TOKEN=
# JIRA_OAUTH_ACCESS_TOKEN_SECRET=
# JIRA_OAUTH_CONSUMER_KEY=
# JIRA_OAUTH_KEY_CERT="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# JIRA_OAUTH_KEY_CERT_FILE=
#
# JIRA_ENABLE_MUTATIONS=False

# ---------------------------------------------------------------------------
# Rocket.Chat - configure an Outgoing WebHook that posts to:
#   https://<agentos-domain>/rocketchat/webhook
# Use ROCKETCHAT_WEBHOOK_TOKEN as the outgoing webhook token.
# ROCKETCHAT_AGENT_ID options: assistente-pemill, jira-ticket-responder, ti-team.
# ---------------------------------------------------------------------------
# ROCKETCHAT_WEBHOOK_TOKEN=
# ROCKETCHAT_AGENT_ID=assistente-pemill
# ROCKETCHAT_BOT_USERNAME=

# ---------------------------------------------------------------------------
# Slack — set both to enable the Slack interface (Assistente Pemill answers there).
#   SLACK_BOT_TOKEN       Bot User OAuth Token (xoxb-***)
#   SLACK_SIGNING_SECRET  Signing Secret (Basic Information → App Credentials)
# ---------------------------------------------------------------------------
# SLACK_BOT_TOKEN=
# SLACK_SIGNING_SECRET=

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=ai
# DB_PASS=ai
# DB_DATABASE=ai
# DB_DRIVER=postgresql+psycopg
