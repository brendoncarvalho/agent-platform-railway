# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------
OPENAI_API_KEY=sk-***
OPENROUTER_API_KEY=sk-or-***
# OPENROUTER_MODEL=~openai/gpt-mini-latest

# ---------------------------------------------------------------------------
# JWT verification for AgentOS. Generate your JWT_VERIFICATION_KEY at os.agno.com.
# In production (RUNTIME_ENV != dev), the app refuses to serve traffic without
# JWT_VERIFICATION_KEY or JWT_JWKS_FILE. Local dev (RUNTIME_ENV=dev) is ok without it.
# Set `authorization=False` in app/main.py to opt out (not recommended).
# ---------------------------------------------------------------------------
# Quote the value so parsers read the multi-line PEM as one variable:
# JWT_VERIFICATION_KEY="-----BEGIN PUBLIC KEY-----
# MIIBIjANBgkq...
# -----END PUBLIC KEY-----"
# JWT_JWKS_FILE=/app/jwks.json

# ---------------------------------------------------------------------------
# AgentOS URL used by the scheduler and MCP server.
# Set this to the public URL of your AgentOS instance.
# ---------------------------------------------------------------------------
# AGENTOS_URL=http://127.0.0.1:8000

# ---------------------------------------------------------------------------
# MCP OAuth — set MCP_CONNECT_SECRET to turn the /mcp endpoint into its own
# OAuth 2.1 authorization server, which is how claude.ai and ChatGPT (web) connect.
# Connecting to the MCP server asks for this secret on a consent page.
# Generate a strong one (≥16 chars):
#   openssl rand -base64 32
# ---------------------------------------------------------------------------
# MCP_CONNECT_SECRET=

# Optional: pin the OAuth token signing key (≥32 chars). Unset, a strong key is
# generated and persisted in the database. Rotating it invalidates outstanding tokens.
# AGENTOS_MCP_SIGNING_KEY=

# ---------------------------------------------------------------------------
# Chief's and the Studio registry's web search tools use the Parallel SDK
# when authenticated, and fall back to Parallel's keyless MCP server otherwise.
# ---------------------------------------------------------------------------
# PARALLEL_API_KEY=

# ---------------------------------------------------------------------------
# Jira - set these to expose guarded Jira tools in the Studio registry.
# Basic auth uses Atlassian account email + API token/password. OAuth 2.0
# uses a Jira Cloud 3LO access token and calls api.atlassian.com with cloudId.
# OAuth 1.0 is available for Jira Server/Data Center-style OAuth apps.
#
# By default Jira is read-only (search/get issue). Set JIRA_ENABLE_MUTATIONS=True
# to expose guarded Jira mutations: comment on any issue; edit only comments
# created by this AI tool; move status, set original estimate, and assign owners
# only when explicit in the user's request; and never delete Jira content.
# ---------------------------------------------------------------------------
# JIRA_AUTH_TYPE=basic
# JIRA_SERVER_URL=https://your-domain.atlassian.net
# JIRA_USERNAME=you@example.com
# JIRA_TOKEN=
# JIRA_PASSWORD=
#
# Jira Cloud OAuth 2.0
# Service account OAuth credentials: set client ID + secret and the app will
# request short-lived access tokens with grant_type=client_credentials.
# You may also set JIRA_OAUTH_ACCESS_TOKEN directly for a temporary/manual test.
# JIRA_AUTH_TYPE=oauth2
# JIRA_OAUTH_CLIENT_ID=
# JIRA_OAUTH_CLIENT_SECRET=
# JIRA_OAUTH_ACCESS_TOKEN=
# JIRA_CLOUD_ID=
#
# Jira OAuth 1.0
# JIRA_AUTH_TYPE=oauth1
# JIRA_OAUTH_ACCESS_TOKEN=
# JIRA_OAUTH_ACCESS_TOKEN_SECRET=
# JIRA_OAUTH_CONSUMER_KEY=
# JIRA_OAUTH_KEY_CERT="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# JIRA_OAUTH_KEY_CERT_FILE=
#
# JIRA_ENABLE_MUTATIONS=False

# ---------------------------------------------------------------------------
# Schedules
# ---------------------------------------------------------------------------
# ENABLE_DEPLOY_CHECK=True
# EVALS_TAG=smoke
# EVALS_CASE_TIMEOUT_SECONDS=90
# EVALS_SUITE_TIMEOUT_SECONDS=900

# ---------------------------------------------------------------------------
# Rocket.Chat - configure an Outgoing WebHook that posts to:
#   https://<agentos-domain>/rocketchat/webhook
# Use ROCKETCHAT_WEBHOOK_TOKEN as the outgoing webhook token.
# ROCKETCHAT_AGENT_ID options: jira-ticket-responder, chief, general-chat.
# ---------------------------------------------------------------------------
# ROCKETCHAT_WEBHOOK_TOKEN=
# ROCKETCHAT_AGENT_ID=jira-ticket-responder
# ROCKETCHAT_BOT_USERNAME=

# ---------------------------------------------------------------------------
# Slack — set both to enable the Slack interface.
#   SLACK_BOT_TOKEN       Bot User OAuth Token (xoxb-***)
#   SLACK_SIGNING_SECRET  Signing Secret (Basic Information → App Credentials)
# ---------------------------------------------------------------------------
# SLACK_BOT_TOKEN=
# SLACK_SIGNING_SECRET=

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=ai
# DB_PASS=ai
# DB_DATABASE=ai
# DB_DRIVER=postgresql+psycopg
